#!/usr/bin/env bash
set -euo pipefail

log() {
  printf '==> %s\n' "$1"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

usage() {
  cat <<'USAGE'
Usage: dotnet-update (--all | --channel <value> [--quality <value>])
       dotnet-update --help

Options:
  --all                Update every installed SDK channel. Stable channels use GA builds;
                       prerelease-only channels use preview builds.
  --channel <value>    Install from a numbered channel (for example, "11.0" or "11.0.1xx").
  --quality <value>    Install the latest GA, preview, or daily build in the specified channel.
                       Requires --channel.
  -h, --help           Show this help message and exit.

The channel and quality options only affect installs performed via the Microsoft installer.
Homebrew-managed installs are upgraded using the existing formula or cask version.
USAGE
}

DOTNET_CHANNEL=""
DOTNET_QUALITY=""
EXPLICIT_CHANNEL=0
UPDATE_ALL=0

parse_args() {
  DOTNET_CHANNEL=""
  DOTNET_QUALITY=""
  EXPLICIT_CHANNEL=0
  UPDATE_ALL=0
  if [[ $# -eq 0 ]]; then
    log "Specify --channel <value> or --all."
    usage
    printf '\n'
    if command_exists dotnet; then
      log "dotnet --info:"
      dotnet --info
    else
      log "dotnet is not on PATH."
    fi
    exit 1
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        UPDATE_ALL=1
        shift
        ;;
      --channel)
        if [[ $# -lt 2 ]]; then
          log "Missing value for --channel"
          usage
          exit 1
        fi
        DOTNET_CHANNEL="$2"
        if [[ ! "${DOTNET_CHANNEL}" =~ ^[0-9]+\.[0-9]+(\.[0-9]+xx)?$ ]]; then
          log "--channel requires a numbered channel such as 11.0 or 11.0.1xx."
          usage
          exit 1
        fi
        EXPLICIT_CHANNEL=1
        shift 2
        ;;
      --quality)
        if [[ $# -lt 2 ]]; then
          log "Missing value for --quality"
          usage
          exit 1
        fi
        case "$2" in
          GA|ga|Ga)
            DOTNET_QUALITY="GA"
            ;;
          preview|Preview|PREVIEW)
            DOTNET_QUALITY="preview"
            ;;
          daily|Daily|DAILY)
            DOTNET_QUALITY="daily"
            ;;
          *)
            log "Invalid quality: $2. Choose GA, preview, or daily."
            usage
            exit 1
            ;;
        esac
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        log "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [[ "${UPDATE_ALL}" -eq 1 && "${EXPLICIT_CHANNEL}" -eq 1 ]]; then
    log "--all cannot be combined with --channel."
    usage
    exit 1
  fi

  if [[ "${UPDATE_ALL}" -eq 1 && -n "${DOTNET_QUALITY}" ]]; then
    log "--all cannot be combined with --quality."
    usage
    exit 1
  fi

  if [[ -n "${DOTNET_QUALITY}" && "${EXPLICIT_CHANNEL}" -ne 1 ]]; then
    log "--quality requires a numbered --channel such as 11.0 or 11.0.1xx."
    usage
    exit 1
  fi

  if [[ "${UPDATE_ALL}" -ne 1 && "${EXPLICIT_CHANNEL}" -ne 1 ]]; then
    log "Specify --channel <value> or --all."
    usage
    exit 1
  fi
}

ALL_CHANNELS=()
ALL_QUALITIES=()

collect_installed_channels() {
  if ! command_exists dotnet; then
    log "Cannot use --all because dotnet is not on PATH."
    exit 1
  fi

  local sdk_list
  sdk_list=$(dotnet --list-sdks)
  if [[ -z "${sdk_list}" ]]; then
    log "Cannot use --all because no installed SDKs were found."
    exit 1
  fi

  ALL_CHANNELS=()
  ALL_QUALITIES=()

  local version
  local unused
  local channel
  local quality
  local index
  local found
  while read -r version unused; do
    if [[ ! "${version}" =~ ^([0-9]+)\.([0-9]+)\. ]]; then
      continue
    fi

    channel="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
    quality="GA"
    if [[ "${version}" == *-* ]]; then
      quality="preview"
    fi

    found=0
    for index in "${!ALL_CHANNELS[@]}"; do
      if [[ "${ALL_CHANNELS[${index}]}" == "${channel}" ]]; then
        found=1
        if [[ "${quality}" == "GA" ]]; then
          ALL_QUALITIES[${index}]="GA"
        fi
        break
      fi
    done

    if [[ "${found}" -eq 0 ]]; then
      ALL_CHANNELS[${#ALL_CHANNELS[@]}]="${channel}"
      ALL_QUALITIES[${#ALL_QUALITIES[@]}]="${quality}"
    fi
  done <<<"${sdk_list}"

  if [[ "${#ALL_CHANNELS[@]}" -eq 0 ]]; then
    log "Cannot use --all because no recognizable SDK channels were found."
    exit 1
  fi
}

BREW_DOTNET_PACKAGE=""
BREW_DOTNET_IS_CASK=0

is_brew_dotnet_installed() {
  if ! command_exists brew; then
    return 1
  fi

  if brew list dotnet >/dev/null 2>&1; then
    BREW_DOTNET_PACKAGE="dotnet"
    BREW_DOTNET_IS_CASK=0
    return 0
  fi

  if brew list dotnet-sdk >/dev/null 2>&1; then
    BREW_DOTNET_PACKAGE="dotnet-sdk"
    BREW_DOTNET_IS_CASK=0
    return 0
  fi

  local casks
  casks=$(brew list --cask 2>/dev/null || true)
  if grep -qx 'dotnet-sdk' <<<"${casks}"; then
    BREW_DOTNET_PACKAGE="dotnet-sdk"
    BREW_DOTNET_IS_CASK=1
    return 0
  fi

  if grep -qx 'dotnet' <<<"${casks}"; then
    BREW_DOTNET_PACKAGE="dotnet"
    BREW_DOTNET_IS_CASK=1
    return 0
  fi

  return 1
}

update_via_brew() {
  log "Updating Homebrew..."
  brew update

  local package=${BREW_DOTNET_PACKAGE:-dotnet}
  if [[ ${BREW_DOTNET_IS_CASK} -eq 1 ]]; then
    log "Upgrading ${package} cask via Homebrew..."
    brew upgrade --cask "${package}"
  else
    log "Upgrading ${package} via Homebrew..."
    brew upgrade "${package}"
  fi
}

sort_sdk_versions() {
  # Compare the numeric version first, then place stable releases above
  # prereleases with the same version. sort -V alone puts RCs above GA.
  awk '{
    original = $0
    version = original
    sub(/\+.*/, "", version)
    core = version
    sub(/-.*/, "", core)
    stable = (version == core)
    prerelease = "-"
    if (!stable) prerelease = substr(version, length(core) + 2)
    print core, stable, prerelease, original
  }' | sort -k1,1V -k2,2n -k3,3V | awk '{ print $4 }'
}

highest_installed_sdk_version() {
  local install_dir="$1"
  local sdk_dir="${install_dir}/sdk"

  if [[ ! -d "${sdk_dir}" ]]; then
    return 0
  fi

  local entry
  local versions=()
  for entry in "${sdk_dir}"/*; do
    if [[ -d "${entry}" ]]; then
      versions+=("$(basename "${entry}")")
    fi
  done

  if [[ "${#versions[@]}" -eq 0 ]]; then
    return 0
  fi

  printf '%s\n' "${versions[@]}" | sort_sdk_versions | tail -n 1
}

resolve_target_version() {
  local install_script="$1"
  local install_dir="$2"
  shift 2

  local dry_run_output
  if ! dry_run_output=$(bash "${install_script}" --install-dir "${install_dir}" "$@" --dry-run 2>&1); then
    return 0
  fi

  if [[ "${dry_run_output}" =~ --version[[:space:]]+\"?([0-9][^\"[:space:]]*) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  fi
}

run_microsoft_installer() {
  local install_script="$1"
  local install_dir="$2"
  local channel="$3"
  local quality="$4"
  local channel_args=()
  if [[ -n "${channel}" ]]; then
    channel_args+=("--channel" "${channel}")
  fi
  if [[ -n "${quality}" ]]; then
    channel_args+=("--quality" "${quality}")
  fi

  # Installing an older SDK over a newer one would overwrite the shared
  # unversioned files (the `dotnet` muxer and friends) with older copies,
  # breaking every newer SDK in the same directory.
  local installer_args=("${channel_args[@]}")
  local installed_version
  local target_version
  installed_version=$(highest_installed_sdk_version "${install_dir}")
  target_version=$(resolve_target_version "${install_script}" "${install_dir}" "${channel_args[@]}")
  if [[ -n "${installed_version}" && -n "${target_version}" ]]; then
    local newest
    newest=$(printf '%s\n%s\n' "${installed_version}" "${target_version}" | sort_sdk_versions | tail -n 1)
    if [[ "${newest}" != "${target_version}" ]]; then
      log "Target ${target_version} is older than installed ${installed_version}; preserving non-versioned files."
      installer_args+=("--skip-non-versioned-files")
    fi
  fi

  local install_selection="channel: ${channel}"
  if [[ -n "${quality}" ]]; then
    install_selection+=", quality: ${quality}"
  fi
  log "Running dotnet-install.sh into ${install_dir} (${install_selection})..."
  bash "${install_script}" --install-dir "${install_dir}" "${installer_args[@]}"
}

install_via_microsoft() {
  local install_dir="$HOME/.dotnet"
  mkdir -p "${install_dir}"

  if [[ "${UPDATE_ALL}" -eq 1 ]]; then
    collect_installed_channels
  fi

  local tmp_dir
  tmp_dir=$(mktemp -d)
  trap 'rm -rf "${tmp_dir}"' EXIT

  local install_script="${tmp_dir}/dotnet-install.sh"
  log "Downloading dotnet-install.sh from Microsoft..."
  curl -sSL https://dot.net/v1/dotnet-install.sh -o "${install_script}"

  if [[ "${UPDATE_ALL}" -eq 1 ]]; then
    local index
    for index in "${!ALL_CHANNELS[@]}"; do
      run_microsoft_installer \
        "${install_script}" \
        "${install_dir}" \
        "${ALL_CHANNELS[${index}]}" \
        "${ALL_QUALITIES[${index}]}"
    done
  else
    run_microsoft_installer \
      "${install_script}" \
      "${install_dir}" \
      "${DOTNET_CHANNEL}" \
      "${DOTNET_QUALITY}"
  fi

  rm -rf "${tmp_dir}"
  trap - EXIT
}

DOTNET_ROOT_EXPORT='export DOTNET_ROOT="$HOME/.dotnet"'
# zsh sources .zprofile then .zshrc, so an unguarded prepend runs twice per
# login shell. Both files are still written: IDEs such as Rider harvest the
# environment from a login shell, while bare `zsh` reads only .zshrc.
PATH_EXPORT='[[ ":$PATH:" == *":$DOTNET_ROOT:"* ]] || export PATH="$DOTNET_ROOT:$PATH"'
LEGACY_PATH_EXPORT='export PATH="$DOTNET_ROOT:$PATH"'

replace_legacy_path_export() {
  local file="$1"

  if ! grep -Fqx "${LEGACY_PATH_EXPORT}" "${file}"; then
    return 0
  fi

  local tmp
  tmp=$(mktemp)
  awk -v legacy="${LEGACY_PATH_EXPORT}" -v replacement="${PATH_EXPORT}" \
    '$0 == legacy { print replacement; next } { print }' "${file}" >"${tmp}"
  cat "${tmp}" >"${file}"
  rm -f "${tmp}"
  log "Replaced unguarded PATH export in ${file}."
}

append_shell_exports() {
  local file="$1"

  if [[ ! -f "${file}" ]]; then
    touch "${file}"
  fi

  if ! grep -Fqx "${DOTNET_ROOT_EXPORT}" "${file}"; then
    printf '\n%s\n' "${DOTNET_ROOT_EXPORT}" >> "${file}"
    log "Added DOTNET_ROOT to ${file}."
  fi

  replace_legacy_path_export "${file}"

  if ! grep -Fqx "${PATH_EXPORT}" "${file}"; then
    printf '\n%s\n' "${PATH_EXPORT}" >> "${file}"
    log "Added PATH update to ${file}."
  fi
}

export_dotnet_path_for_session() {
  export DOTNET_ROOT="$HOME/.dotnet"
  if [[ ":${PATH}:" != *":${DOTNET_ROOT}:"* ]]; then
    export PATH="${DOTNET_ROOT}:${PATH}"
  fi
}

main() {
  parse_args "$@"
  local used_microsoft_install=0

  if is_brew_dotnet_installed; then
    if [[ "${UPDATE_ALL}" -eq 1 ]]; then
      log "--all is not supported for Homebrew-managed .NET installations."
      log "Homebrew can only upgrade the installed formula or cask as a package."
      exit 1
    fi
    log "Detected Homebrew-managed .NET installation."
    update_via_brew
  else
    used_microsoft_install=1
    log "No Homebrew-managed .NET installation detected. Using Microsoft installer."
    install_via_microsoft
  fi

  if [[ ${used_microsoft_install} -eq 1 ]]; then
    append_shell_exports "$HOME/.zprofile"
    append_shell_exports "$HOME/.zshrc"
    export_dotnet_path_for_session
  fi

  log "dotnet --info:"
  dotnet --info
}

main "$@"
